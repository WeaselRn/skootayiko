# Copy to .env and fill in the three keys.
# Do NOT also keep a .env.local with empty values: Next.js gives .env.local
# priority, so an empty key there would shadow the real key in .env.

# --- Map tiles: MapTiler (CLIENT-VISIBLE; restrict key by allowed HTTP origins in the MapTiler dashboard) ---
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAP_STYLE=streets-v2
NEXT_PUBLIC_MAP_CENTER_LAT=9.9816
NEXT_PUBLIC_MAP_CENTER_LON=76.2999
NEXT_PUBLIC_MAP_ZOOM=11

# --- Geocoding: LocationIQ (SERVER ONLY) ---
LOCATIONIQ_API_KEY=
# Use https://eu1.locationiq.com/v1 if your key is on the EU region.
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1
# lon_min,lat_max,lon_max,lat_min (Kochi / Ernakulam district)
GEOCODE_VIEWBOX=75.9,10.3,76.6,9.7
GEOCODE_COUNTRY=in

# --- Road + walking directions: HeiGIT openrouteservice (SERVER ONLY) ---
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# Self-imposed guards below the free-tier caps (2000 directions/day, 40/min).
ORS_DAILY_BUDGET=1500
ORS_RATE_PER_MIN=35
# Fallback street geometry when ORS is out of quota (OSRM, OpenStreetMap data). "off" disables it.
OSRM_BASE_URL=https://routing.openstreetmap.de

# --- Routing engine ---
GTFS_METRO_DIR=./metro details
GTFS_BUS_DIR=./kochi bus details
GTFS_CACHE_DIR=./.cache/gtfs
MAX_WALK_METERS=800
MAX_TRANSFERS=3
# true = serve hand-made fixtures from src/fixtures instead of the routing engine.
USE_MOCK_ROUTES=false

# --- App ---
APP_ENV=development
ROUTE_CACHE_TTL_SECONDS=900
